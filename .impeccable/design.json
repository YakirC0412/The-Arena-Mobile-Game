      "html": "<button class=\"ds-btn-primary\">המשך</button>",
      "css": ".ds-btn-primary{font-family:Heebo,system-ui,sans-serif;direction:rtl;background:#7CCBFF;color:#04112F;font-weight:900;font-size:16px;height:56px;padding:0 16px;border:none;border-radius:14px;box-shadow:0 4px 16px rgba(124,203,255,.45);width:100%;transition:transform .15s}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:3px solid #D9F7FF;outline-offset:2px}"
    },
