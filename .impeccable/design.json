      "css": ".ds-skip{font-family:Heebo,system-ui,sans-serif;direction:rtl;display:flex;flex-direction:column;align-items:center;justify-content:center;width:76px;height:52px;border:2px solid #F8C95C;border-radius:12px;background:transparent;color:#F8C95C}.ds-skip b{font-size:14px}.ds-skip span{font-size:12px}.ds-skip:active{opacity:.7}"
