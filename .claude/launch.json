{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arena-web",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": [
        "mobile/node_modules/expo/bin/cli",
        "start",
        "mobile",
        "--web",
        "--port",
        "8090"
      ],
      "port": 8090,
      "autoPort": false
    },
    {
      "name": "arena-admin",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": [
        "admin/server.js"
      ],
      "port": 8095,
      "autoPort": false
    },
    {
      "name": "arena-server",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": [
        "server/dist/server/src/index.js"
      ],
      "port": 2567,
      "autoPort": false
    }
  ]
}