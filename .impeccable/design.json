  "narrative": {
    "northStar": "זירת הלילה (The Night Arena)",
    "overview": "A stadium at night: deep navy fills everything, light blue is the floodlight, and gold appears only at the moments that matter (a chosen target, a skip, the champion). The screen is dark and tense but never noisy; it stays readable under a running clock. Everything is built for one thumb on a phone in portrait, in Hebrew, right to left.\n\nThe system is flat in structure and glowing in emphasis. Surfaces are tonal steps of the same navy; important things (the main button, the arena frame, the active clock) get a soft coloured glow instead of a classic drop shadow. Controls are large, rounded and confident, with a clear pressed response. The picture being identified is always the largest thing on a duel screen.",
    "keyCharacteristics": [
      "Dark only; one navy family from `navy-deep` to `surface-raised`, plus a single light-blue voice.",
      "Glow, not shadow: depth is expressed by coloured halos and outlines.",
      "Gold is rare and means \"chosen / special\".",
      "Large touch targets (44 pt minimum), rounded corners, tactile press feedback.",
      "Hebrew first, RTL layout; text is Heebo only."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Light blue is the only action colour; gold never competes with it for the same job.",
        "section": "colors"
      },
      {
        "name": "The Real Green Rule",
        "body": "Green means \"correct answer\" and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Floor Colour Rule",
        "body": "Board colours keep one meaning in every situation: floor = ordinary territory, light blue = me/drawn/winner, blue with cyan outline = can be attacked, gold = chosen, dark = not relevant now.",
        "section": "colors"
      },
      {
        "name": "The Black Is Rare Rule",
        "body": "The Black face is for headings, clocks and buttons; everything else uses Bold or Medium.",
        "section": "typography"
      },
      {
        "name": "The Glow Not Shadow Rule",
        "body": "If something needs to stand out it glows in its own colour; nothing casts a grey shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "- **Do** use only tokens from `design/tokens.ts`; never raw hex in screens.",
      "- **Do** keep the picture the largest element of a duel, even with the keyboard open.",
      "- **Do** make every touch target at least 44 pt and every main action 56 pt.",
      "- **Do** express emphasis with a coloured glow or a gold border.",
      "- **Do** write all copy in Hebrew, correctly gendered (masculine/feminine forms)."
    ],
    "donts": [
      "- **Don't** add a second action colour or use gold for ordinary buttons.",
      "- **Don't** use grey drop shadows, light surfaces or white screens.",
      "- **Don't** cut text with an ellipsis where it can wrap (category names, player names).",
      "- **Don't** use text under 12 pt.",
      "- **Don't** shift layout on press; use opacity or a small scale only.",
      "- **Don't** change the logo's navy and light-blue identity."
    ]
  }
}