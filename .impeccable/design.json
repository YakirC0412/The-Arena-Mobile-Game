      "css": ".ds-btn-secondary{font-family:Heebo,system-ui,sans-serif;direction:rtl;background:rgba(124,203,255,.16);color:#fff;font-weight:700;font-size:16px;height:56px;padding:0 16px;border:2px solid #7CCBFF;border-radius:14px;width:100%}.ds-btn-secondary:active{transform:scale(.98)}.ds-btn-secondary:focus-visible{outline:3px solid #D9F7FF;outline-offset:2px}"
    },
