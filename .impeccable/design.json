      "html": "<div class=\"ds-board\"><div class=\"ds-cell ds-target\">אתרים</div><div class=\"ds-cell ds-me\">חיות</div><div class=\"ds-cell ds-floor\">פירות</div></div>",
      "css": ".ds-board{display:flex;gap:6px;padding:8px;border:2px solid #3FA9FF;border-radius:20px;background:#0B2470;box-shadow:0 0 14px rgba(63,169,255,.4)}.ds-cell{font-family:Heebo,system-ui,sans-serif;direction:rtl;font-weight:700;font-size:13px;width:80px;height:80px;display:flex;align-items:center;justify-content:center;border-radius:8px;color:#fff}.ds-target{background:#1F6BFF;border:3px solid #4DF3FF}.ds-me{background:#7CCBFF;border:2px solid #D9F7FF;color:#0B2470}.ds-floor{background:#0A1F5C;border:1px solid #1C3C8C}"
    }
